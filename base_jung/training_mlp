"""
Treinamento e Validação: Rede Neural Artificial (MLP)
Previsão da Entalpia de Formação de materiais 2D e Teste de Aproximação Universal
"""

import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import warnings
import joblib
from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.neural_network import MLPRegressor
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.exceptions import ConvergenceWarning

# Ignorando avisos de convergência estritamente para a fase de testes
warnings.filterwarnings("ignore", category=ConvergenceWarning)

def executar_pipeline_rna(X, y, nome_etapa, max_iter=1000, salvar_modelo=False):
    """
    Função universal que recebe uma matriz de features (X) e um alvo (y),
    treina uma Rede Neural e retorna as métricas de avaliação.
    """
    print(f"\n" + "="*50)
    print(f" EXECUTANDO: {nome_etapa.upper()}")
    print("="*50)

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=42
    )
    
    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)
    X_test_scaled = scaler.transform(X_test)

    print("Treinando a Rede Neural...")
    
    modelo = MLPRegressor(
        hidden_layer_sizes=(100, 50),
        activation='relu',
        solver='adam',
        max_iter=max_iter,
        learning_rate_init=0.001,
        random_state=42
    )
    
    modelo.fit(X_train_scaled, y_train)
    print(f"Rede Neural convergida com sucesso!")

    y_pred = modelo.predict(X_test_scaled)
    cv_scores = cross_val_score(modelo, X_train_scaled, y_train, cv=5, scoring='r2')
    
    r2 = r2_score(y_test, y_pred)
    mae = mean_absolute_error(y_test, y_pred)
    rmse = np.sqrt(mean_squared_error(y_test, y_pred))

    print(f"\n--- Métricas Finais ---")
    print(f"R² Teste:       {r2:.4f}")
    print(f"MAE Teste:      {mae:.4f}")
    print(f"RMSE Teste:     {rmse:.4f}")
    print(f"R² CV (5-Fold): {cv_scores.mean():.4f}")

    if salvar_modelo:
        os.makedirs('results/figures', exist_ok=True)
        fig, axes = plt.subplots(1, 2, figsize=(14, 6))

        axes[0].scatter(y_test, y_pred, alpha=0.5, s=15, color='#9467bd', edgecolors='white', linewidth=0.3)
        lim_min = min(y_test.min(), y_pred.min())
        lim_max = max(y_test.max(), y_pred.max())
        axes[0].plot([lim_min, lim_max], [lim_min, lim_max], 'r--', linewidth=1.5, label='Previsão Perfeita')
        axes[0].set_xlabel('hform Real')
        axes[0].set_ylabel('hform Previsto')
        axes[0].set_title(f'Rede Neural — R² = {r2:.4f}')
        axes[0].legend()

        axes[1].plot(modelo.loss_curve_, color='#d62728', linewidth=2)
        axes[1].set_xlabel('Épocas (Iterações)')
        axes[1].set_ylabel('Função de Custo (Loss)')
        axes[1].set_title('Convergência do Erro')

        plt.tight_layout()
        plt.savefig('TCC/results/figures/rede_neural_resultados.png', dpi=300, bbox_inches='tight')
        plt.close()
        
        os.makedirs('models', exist_ok=True)
        joblib.dump(modelo, 'models/rede_neural.pkl')
        joblib.dump(scaler, 'models/scaler_rna.pkl')
        print("\n-> Modelo, Scaler e Gráficos salvos com sucesso!")

def main():

    # ETAPA 1: CALIBRAÇÃO
    np.random.seed(42)
    x1 = np.random.rand(400) * 10
    x2 = np.random.rand(400) * 10
    y_perfeito = 15 * np.sin(x1) + (x2**2)

    df_teste = pd.DataFrame({'f1': x1, 'f2': x2, 'hform': y_perfeito})
    X_sintetico = df_teste[['f1', 'f2']]
    y_sintetico = df_teste['hform']

    executar_pipeline_rna(
        X=X_sintetico, 
        y=y_sintetico, 
        nome_etapa="Validação do Aproximador Universal", 
        max_iter=1500, 
        salvar_modelo=False
    )

    # ETAPA 2: PROJETO PRINCIPAL
    caminho_dados = '/home/maria_alice/TCC/data/c2db_features_selecionadas.csv'
    try:
        df_real = pd.read_csv(caminho_dados)
    except FileNotFoundError:
        print(f"\nERRO: O arquivo '{caminho_dados}' não foi encontrado.")
        return

    target = 'hform'
    features = [col for col in df_real.columns if col not in [target, 'formula']]
    
    X_real = df_real[features].fillna(0)
    y_real = df_real[target]

    executar_pipeline_rna(
        X=X_real, 
        y=y_real, 
        nome_etapa="Treinamento com Dados Reais (C2DB)", 
        max_iter=1000, 
        salvar_modelo=True
    )

if __name__ == "__main__":
    main()