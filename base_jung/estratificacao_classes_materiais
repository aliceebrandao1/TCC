"""
Estratificação de Erros por Família Cristalográfica (Versão Refinada)
Painel Comparativo: Regressão Linear, Gradient Boosting, Random Forest e Rede Neural
"""

import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import joblib
from sklearn.model_selection import train_test_split
from pymatgen.core import Composition
import warnings

warnings.filterwarnings("ignore")

def classificar_familia_2d(formula_str):
    """
    Tradutor Químico: Lê a string da fórmula e classifica o material 2D
    com subdivisões focadas na literatura de estabilidade termodinâmica.
    Isola materiais monoelementares e detalha classes complexas.
    """
    try:
        comp = Composition(formula_str)
        elementos = [el.symbol for el in comp.elements]
        num_elementos = len(elementos)
    except:
        return 'Fórmula Inválida'

    metais_transicao = ['Sc', 'Ti', 'V', 'Cr', 'Mn', 'Fe', 'Co', 'Ni', 'Cu', 'Zn', 
                        'Y', 'Zr', 'Nb', 'Mo', 'Tc', 'Ru', 'Rh', 'Pd', 'Ag', 'Cd',
                        'Hf', 'Ta', 'W', 'Re', 'Os', 'Ir', 'Pt', 'Au', 'Hg']
    calcogenios = ['S', 'Se', 'Te']
    halogenios = ['F', 'Cl', 'Br', 'I']
    ametais_cnb = ['C', 'N', 'B'] # Carbono, Nitrogênio, Boro

    tem_metal = any(el in metais_transicao for el in elementos)
    tem_calcogenio = any(el in calcogenios for el in elementos)
    tem_halogenio = any(el in halogenios for el in elementos)
    tem_oxigenio = 'O' in elementos
    tem_cnb = any(el in ametais_cnb for el in elementos)

    # 1. Monoelementares (Corretamente isolados)
    if num_elementos == 1:
        return 'Monoelementares'

    # 2. Refinando Haletos com Metais de Transição (MT)
    if tem_halogenio and tem_metal:
        if num_elementos == 2:
            return 'Haletos com MT (Binários)'
        else:
            if tem_calcogenio:
                return 'Calco-haletos com MT (ex: MoSBr)'
            elif tem_oxigenio:
                return 'Oxialetos com MT (ex: FeOCl)'
            else:
                return 'Haletos com MT (Janus/Mistos)'

    # 3. Haletos com Calcogênios
    if tem_halogenio and tem_calcogenio:
        if num_elementos == 2:
            return 'Haletos c/ Calcogênios (Binários)'
        else:
            return 'Haletos c/ Calcogênios (Multicomp.)'

    # 4. TMDs (Dicalcogenetos e Ligas)
    if tem_metal and tem_calcogenio:
        if num_elementos == 2:
            return 'TMDs Clássicos (Binários)'
        else:
            return 'TMDs Janus / Ligas (Ternários+)'

    # 5. Refinando os Antigos "Outros Binários"
    if num_elementos == 2:
        if tem_oxigenio:
            return 'Óxidos Binários'
        elif tem_cnb:
            return 'Carbetos/Nitretos/Boretos (Binários)'
        else:
            return 'Outros Binários (Pnicogenetos, etc)'

    # 6. Refinando Outros Multicomponentes
    if tem_oxigenio:
        return 'Óxidos Multicomp. (Perovskitas, etc)'
        
    return 'Outros Multicomponentes'

def main():
    print("\n" + "="*70)
    print(" INICIANDO ESTRATIFICAÇÃO DE ERROS REFINADA (PAINEL 2x2) ")
    print("="*70)

    caminho_dados = '/home/maria_alice/TCC/data/c2db_features_selecionadas.csv'
    try:
        df = pd.read_csv(caminho_dados)
    except FileNotFoundError:
        print("ERRO: Arquivo de dados não encontrado. Verifique o caminho absoluto.")
        return

    target = 'hform'
    features = [col for col in df.columns if col not in [target, 'formula']]

    X = df[features].fillna(0)
    y = df[target]

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=42
    )
    
    df_test = df.loc[X_test.index].copy()

    print("Carregando modelos treinados...")
    try:
        modelos = {
            'LR':  (joblib.load('/home/maria_alice/TCC/models/regressao_linear.pkl'), joblib.load('/home/maria_alice/TCC/models/scaler_regressao_linear.pkl')),
            'GB':  (joblib.load('/home/maria_alice/TCC/models/gradient_boosting.pkl'), joblib.load('/home/maria_alice/TCC/models/scaler_gb.pkl')),
            'RF':  (joblib.load('/home/maria_alice/TCC/models/random_forest.pkl'), joblib.load('/home/maria_alice/TCC/models/scaler_rf.pkl')),
            'RNA': (joblib.load('/home/maria_alice/TCC/models/rede_neural.pkl'), joblib.load('/home/maria_alice/TCC/models/scaler_rna.pkl')) 
        }
    except FileNotFoundError as e:
        print(f"ERRO: Algum modelo não foi encontrado. Detalhe: {e}")
        return

    print("Calculando erros absolutos por família química...")
    for nome, (modelo, scaler) in modelos.items():
        X_test_scaled = scaler.transform(X_test)
        pred = modelo.predict(X_test_scaled)
        df_test[f'erro_abs_{nome}'] = np.abs(df_test['hform'] - pred)

    df_test['Classe'] = df_test['formula'].apply(classificar_familia_2d)

    # --- ETAPA DE VALIDAÇÃO (Verificação de classes únicas) ---
    print("\nVerificando se há materiais atribuídos a múltiplas classes...")
    materiais_unicos_classes = df_test.groupby('formula')['Classe'].nunique()
    conflitos = materiais_unicos_classes[materiais_unicos_classes > 1]
    
    if not conflitos.empty:
        print(f"ATENÇÃO! Materiais em mais de uma classe encontrados:\n{conflitos}")
    else:
        print("-> CHECK OK: Nenhum material se repete em mais de uma classe. (Mapeamento 1:1 validado)")
    print("-" * 70 + "\n")
    # ----------------------------------------------------------

    # Exportando a lista completa de materiais por classe
    os.makedirs('/home/maria_alice/TCC/results/tables', exist_ok=True)
    caminho_lista_classes = '/home/maria_alice/TCC/results/tables/materiais_por_classe_refinada.csv'
    
    df_materiais_classes = df_test[['Classe', 'formula']].sort_values(by=['Classe', 'formula'])
    df_materiais_classes.to_csv(caminho_lista_classes, index=False, encoding='utf-8')
    print(f"-> Tabela de classificação gerada em: '{caminho_lista_classes}'")

    resumo = df_test.groupby('Classe').agg(
        MAE_LR=('erro_abs_LR', 'mean'),
        MAE_GB=('erro_abs_GB', 'mean'),
        MAE_RF=('erro_abs_RF', 'mean'),
        MAE_RNA=('erro_abs_RNA', 'mean'),
        Quantidade=('formula', 'count')
    ).reset_index()

    resumo = resumo.sort_values(by='MAE_LR', ascending=True)

    print("Gerando painel gráfico de estratificação...")
    os.makedirs('/home/maria_alice/TCC/results/figures', exist_ok=True)
    
    # Aumentado o figsize para acomodar o maior número de classes
    fig, axes = plt.subplots(2, 2, figsize=(16, 15), sharex=True)
    fig.suptitle('Estratificação do Erro Absoluto Médio (MAE) por Família de Material 2D Refinada', fontsize=16, y=0.93)

    configs_grafico = [
        (axes[0, 0], 'MAE_LR', 'Regressão Linear', '#5B86E5'),
        (axes[0, 1], 'MAE_GB', 'Gradient Boosting', '#ff7f50'),
        (axes[1, 0], 'MAE_RF', 'Random Forest', '#2ca02c'),
        (axes[1, 1], 'MAE_RNA', 'Rede Neural', '#d62728')
    ]

    for ax, coluna_erro, titulo, cor in configs_grafico:
        barras = ax.barh(resumo['Classe'], resumo[coluna_erro], color=cor, edgecolor='black', alpha=0.8)
        ax.set_title(titulo, fontsize=14)
        ax.grid(axis='x', linestyle='--', alpha=0.6)
        
        if ax in [axes[0, 1], axes[1, 1]]:
            ax.set_yticklabels([])
            
        for barra, qtde in zip(barras, resumo['Quantidade']):
            ax.text(barra.get_width() + 0.01, barra.get_y() + barra.get_height()/2, 
                    f"(n={qtde})", va='center', fontsize=9, color='gray')

    axes[1, 0].set_xlabel('Erro Absoluto Médio (MAE) (eV/átomo)', fontsize=12)
    axes[1, 1].set_xlabel('Erro Absoluto Médio (MAE) (eV/átomo)', fontsize=12)

    plt.subplots_adjust(wspace=0.05, hspace=0.15)
    
    caminho_figura = '/home/maria_alice/TCC/results/figures/painel_estratificacao_refinada.png'
    plt.savefig(caminho_figura, dpi=300, bbox_inches='tight')
    plt.close()
    
    print(f"-> Painel comparativo salvo com sucesso em '{caminho_figura}'")
    print("="*70 + "\n")

if __name__ == "__main__":
    main()