plt.title("Interseção de Outliers (> 0.5 eV)")
plt.savefig('/home/maria_alice/TCC/results/figures/analise_matriz_outliers.png', dpi=300, bbox_inches='tight')
plt.close()

# ADENDO VISUAL: Mapa de Calor dos Piores Materiais (Todos os Modelos)
