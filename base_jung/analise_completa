# PARTE 0 (Continuação): Densidade Contínua de Erros (MAE e MAPE)
# =========================================================================
print("\nGerando Gráficos de Densidade Contínua (Erro Absoluto e Percentual)...")
fig, axes = plt.subplots(1, 2, figsize=(11.5, 4.8))

for m in model_names:
    err_abs = np.abs(y_test - preds[m])
    sns.kdeplot(err_abs, ax=axes[0], label=m, fill=True, alpha=0.2, linewidth=2.2)

