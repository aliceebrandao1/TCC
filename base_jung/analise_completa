"""
ANÁLISE COMPLETA DE MODELOS (PREVISÃO DE ENTALPIA DE FORMAÇÃO - HFORM)
"""

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import os
import warnings
from sklearn.model_selection import train_test_split, learning_curve
from sklearn.metrics import mean_absolute_error
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LinearRegression
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.neural_network import MLPRegressor
import shap
from pymatgen.core import Composition

warnings.filterwarnings('ignore')

# Configurações globais de saída
FIG_DIR = '/home/maria_alice/TCC/results/figures'
os.makedirs(FIG_DIR, exist_ok=True)
DPI = 600

print("1. Carregando Dados e Traduzindo Química...")
caminho_dados = '/home/maria_alice/TCC/data/c2db_features_selecionadas.csv'
try:
    df = pd.read_csv(caminho_dados)
except FileNotFoundError:
    print(f"ERRO: Arquivo não encontrado em {caminho_dados}")
    exit()

target = 'hform'
features = [col for col in df.columns if col not in [target, 'formula']]

def classificar_familia_2d(formula_str):
    try:
        comp = Composition(formula_str)
        elementos = [el.symbol for el in comp.elements]
        estequiometria = list(comp.as_dict().values())
    except:
        return 'Inválida'

    metais_transicao = [
        'Sc', 'Ti', 'V', 'Cr', 'Mn', 'Fe', 'Co', 'Ni', 'Cu', 'Zn',
        'Y', 'Zr', 'Nb', 'Mo', 'Tc', 'Ru', 'Rh', 'Pd', 'Ag', 'Cd',
        'Hf', 'Ta', 'W', 'Re', 'Os', 'Ir', 'Pt', 'Au', 'Hg'
    ]
    calcogenios = ['S', 'Se', 'Te']
    halogenios = ['F', 'Cl', 'Br', 'I']

    if any(el in halogenios for el in elementos):
        return 'Haletos'
    if 'O' in elementos:
        return 'Óxidos'

    if len(elementos) == 2:
        atomo1, atomo2 = elementos[0], elementos[1]
        tem_metal = (atomo1 in metais_transicao) or (atomo2 in metais_transicao)
        tem_calcogenio = (atomo1 in calcogenios) or (atomo2 in calcogenios)

        # Confere se é um TMD legítimo (Metal + Calcogênio na proporção 1:2)
        if tem_metal and tem_calcogenio and (estequiometria == [1.0, 2.0] or estequiometria == [2.0, 1.0]):
            return 'TMDs'
        else:
            return 'Outros Binários'

    return 'Multicomponentes'

df['Family'] = df['formula'].apply(classificar_familia_2d)

X = df[features].fillna(0)
y = df[target]

X_train, X_test, y_train, y_test, idx_train, idx_test = train_test_split(
    X, y, df.index, test_size=0.20, random_state=42
)

scaler = StandardScaler()
X_train_scaled = pd.DataFrame(scaler.fit_transform(X_train), columns=features)
X_test_scaled = pd.DataFrame(scaler.transform(X_test), columns=features)

df_test = df.iloc[idx_test].copy().reset_index(drop=True)
y_test = y_test.values

# =========================================================================
# TREINAMENTO BASE DAS ARQUITETURAS
# =========================================================================
models = {
    'Linear': LinearRegression(),
    'Gradient Boosting': GradientBoostingRegressor(n_estimators=100, random_state=42),
    'Random Forest': RandomForestRegressor(n_estimators=100, n_jobs=-1, random_state=42),
    'Rede Neural': MLPRegressor(hidden_layer_sizes=(100, 50), max_iter=300, random_state=42)
}

preds = {}
maes = {}

print("Treinando as arquiteturas (Isso pode levar alguns segundos)...")
for m_name, model in models.items():
    model.fit(X_train_scaled, y_train)
    y_p = model.predict(X_test_scaled)
    preds[m_name] = y_p
    maes[m_name] = mean_absolute_error(y_test, y_p)
print("Treinamento concluído!\n")

mapes = {
    m: np.mean(np.abs((y_test[np.abs(y_test) > 0.05] - preds[m][np.abs(y_test) > 0.05]) / y_test[np.abs(y_test) > 0.05]))
    for m in models.keys()
}
tabela_metricas = pd.DataFrame({'MAE (eV)': maes, 'MAPE': mapes})
tabela_metricas['MAPE'] = tabela_metricas['MAPE'].apply(lambda x: f"{x:.2%}")
print("\n--- MÉTRICAS GLOBAIS ---")
print(tabela_metricas)

# =========================================================================
# PARTE 0: Distribuição por Faixa de Erro (Com Porcentagens)
# =========================================================================
print("Gerando Parte 0: Gráfico de Faixas de Erro...")
def get_bands_pct(y_t, y_p):
    errors = np.abs(y_t - y_p)
    total = len(y_t)
    return {
        '<0.1': (errors < 0.1).sum() / total * 100,
        '0.1-0.2': ((errors >= 0.1) & (errors < 0.2)).sum() / total * 100,
        '0.2-0.5': ((errors >= 0.2) & (errors < 0.5)).sum() / total * 100,
        '>0.5': (errors >= 0.5).sum() / total * 100
    }

bands_data = {m: get_bands_pct(y_test, preds[m]) for m in models.keys()}
bands_labels = ['<0.1', '0.1-0.2', '0.2-0.5', '>0.5']
colors = ['#1a9850', '#a6d96a', '#fdae61', '#d73027']

fig, ax = plt.subplots(figsize=(9.5, 5.2))
bottoms = np.zeros(len(models))
model_names = list(models.keys())

for i, band in enumerate(bands_labels):
    values = [bands_data[m][band] for m in model_names]
    ax.bar(
        model_names, values, bottom=bottoms,
        label=f'{band} eV/átomo', color=colors[i],
        edgecolor='white', linewidth=0.8
    )

    for j, val in enumerate(values):
        if val > 2.5:
            text_color = 'white' if i == 0 or i == 3 else 'black'
            ax.text(
                j, bottoms[j] + val / 2, f'{val:.1f}%',
                ha='center', va='center', color=text_color,
                fontweight='bold', fontsize=11
            )

    bottoms += np.array(values)

ax.set_ylabel('Fração do Conjunto de Teste (%)', fontsize=14)
ax.set_title('Composição do Erro Absoluto por Arquitetura', fontsize=15, pad=12)
ax.set_ylim(0, 102)
ax.tick_params(axis='both', labelsize=12)
ax.grid(True, axis='y', linestyle=':', alpha=0.5)
ax.legend(
    title='|Erro| (eV/átomo)', title_fontsize=12, fontsize=11,
    bbox_to_anchor=(1.02, 1), loc='upper left', frameon=True
)
plt.tight_layout()
plt.savefig(os.path.join(FIG_DIR, 'analise_faixas_erro.png'), dpi=DPI, bbox_inches='tight')
plt.close()

# =========================================================================
# PARTE 1: Interseção e Diagnóstico Físico (Onde todos falham?)
# =========================================================================
print("\nGerando Parte 1: Matriz de Co-ocorrência de Anomalias...")
outliers_df = pd.DataFrame({m: np.abs(y_test - preds[m]) > 0.5 for m in models.keys()})

cooc_matrix = np.zeros((4, 4))
keys = list(models.keys())
for i in range(4):
    for j in range(4):
        cooc_matrix[i, j] = np.sum(outliers_df[keys[i]] & outliers_df[keys[j]])

fig, ax = plt.subplots(figsize=(7.2, 5.8))
sns.heatmap(
    cooc_matrix, annot=True, fmt=".0f",
    xticklabels=keys, yticklabels=keys, cmap="Reds",
    annot_kws={'size': 13, 'weight': 'bold'},
    linewidths=0.6, ax=ax
)
ax.set_title("Interseção de Outliers (|Erro| > 0,5 eV/átomo)", fontsize=14, pad=12)
ax.tick_params(axis='x', labelsize=12, rotation=15)
ax.tick_params(axis='y', labelsize=12, rotation=0)
cbar = ax.collections[0].colorbar
cbar.ax.tick_params(labelsize=11)

plt.tight_layout()
plt.savefig(os.path.join(FIG_DIR, 'analise_matriz_outliers.png'), dpi=DPI, bbox_inches='tight')
plt.close()

# ADENDO VISUAL: Mapa de Calor dos Piores Materiais (Todos os Modelos)
print("\nGerando Mapa de Calor dos Piores Outliers Nominais...")
df_erros = df_test[['formula', 'Family']].copy()
for m in models.keys():
    df_erros[m] = np.abs(y_test - preds[m])
df_erros['Erro_Medio'] = df_erros[list(models.keys())].mean(axis=1)

top_outliers = df_erros.sort_values(by='Erro_Medio', ascending=False).head(15)
top_outliers['Rotulo'] = top_outliers['formula'] + " (" + top_outliers['Family'] + ")"
top_outliers = top_outliers.set_index('Rotulo')
dados_heatmap = top_outliers[list(models.keys())]

fig, ax = plt.subplots(figsize=(9.5, 7.5))
sns.heatmap(
    dados_heatmap, annot=True, fmt=".2f", cmap="YlOrRd",
    annot_kws={'size': 11},
    cbar_kws={'label': 'Erro Absoluto (eV/átomo)'},
    linewidths=0.5, ax=ax
)
ax.set_title('Top 15 Materiais Mais Críticos: Erro Absoluto por Modelo', fontsize=15, pad=14)
ax.set_ylabel('')
