os.makedirs('results/figures', exist_ok=True)
caminho_mapa = 'results/figures/heatmap_outliers_nominais.png'
plt.savefig(caminho_mapa, dpi=300, bbox_inches='tight')
plt.close()

print(f"-> Mapa de calor salvo lindamente em: {caminho_mapa}")


# =========================================================================
# PARTE 0 (Continuação): Histogramas de Distribuição (MAE e MAPE)
