ax.tick_params(axis='x', labelsize=12, rotation=15)
ax.tick_params(axis='y', labelsize=11)

cbar = ax.collections[0].colorbar
cbar.ax.yaxis.label.set_size(13)
cbar.ax.tick_params(labelsize=11)

caminho_mapa = os.path.join(FIG_DIR, 'heatmap_outliers_nominais.png')
plt.tight_layout()
plt.savefig(caminho_mapa, dpi=DPI, bbox_inches='tight')
plt.close()
print(f"-> Mapa de calor salvo em: {caminho_mapa}")

